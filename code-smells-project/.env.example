# Copie para .env (não versionado) ou exporte no ambiente.
# Chave de assinatura do Flask; se vazia, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
# true habilita o modo debug do Flask (nunca em produção).
FLASK_DEBUG=false
# Valor exibido em GET /health.
APP_ENV=producao
DATABASE_PATH=loja.db
HOST=0.0.0.0
PORT=5000
# Token exigido no header X-Admin-Token para /admin/*. Vazio = rotas admin desabilitadas (403).
ADMIN_TOKEN=
# Origens permitidas no CORS (ex.: https://loja.exemplo.com). "*" libera todas.
CORS_ORIGINS=*
LOG_LEVEL=INFO
