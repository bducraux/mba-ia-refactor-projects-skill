# Copy to .env (never commit it) or export these variables before `npm start`.
PORT=3000
# SQLite file path; ":memory:" recreates and seeds the database at every boot.
DB_PATH=:memory:
# Payment gateway key (use a test key locally).
PAYMENT_GATEWAY_KEY=pk_test_change_me
# Token required in the X-Admin-Token header for admin endpoints. Empty = admin endpoints disabled.
ADMIN_TOKEN=change-me
# debug | info | error
LOG_LEVEL=info
