# Copy to .env and adjust. Never commit the real .env.

# Flask / server
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
# Comma-separated list of allowed origins ("*" allows any origin)
CORS_ORIGINS=*

# Database (relative SQLite paths live under instance/)
DATABASE_URL=sqlite:///tasks.db

# Authentication tokens issued by POST /login
TOKEN_MAX_AGE_SECONDS=86400

# E-mail notifications (leave SMTP_HOST empty to disable sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
