# Copy to .env and adjust. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=*
LOG_LEVEL=INFO
TOKEN_MAX_AGE_SECONDS=86400

# Optional: e-mail notifications are skipped while SMTP_HOST is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
